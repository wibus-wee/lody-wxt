{
  "name": "@lody-mobile/sdk",
  "version": "0.1.0",
  "private": true,
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rpc": {
      "types": "./dist/sessions/infrastructure/json-rpc-streams.d.ts",
      "import": "./dist/sessions/infrastructure/json-rpc-streams.js"
    },
    "./rpc/source": {
      "types": "./src/sessions/infrastructure/json-rpc-streams.ts",
      "import": "./src/sessions/infrastructure/json-rpc-streams.ts"
    },
    "./loro": {
      "types": "./dist/loro-runtime.d.ts",
      "import": "./dist/loro-runtime.js"
    },
    "./loro/source": {
      "types": "./src/loro-runtime.ts",
      "import": "./src/loro-runtime.ts"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@loro-dev/flock-wasm": "^0.4.3",
    "@loro-dev/streams-client": "0.8.0",
    "@loro-dev/streams-crdt": "0.16.0",
    "base64-js": "1.5.1",
    "birpc": "4.2.0",
    "croner": "10.0.1",
    "loro-crdt": "1.16.3",
    "loro-repo": "0.21.0",
    "ofetch": "1.5.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.27.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "undici": "npm:undici-types@8.9.0"
  }
}
