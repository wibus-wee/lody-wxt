{
  "name": "lody-wxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm ui:update && wxt",
    "dev:firefox": "pnpm ui:update && wxt -b firefox",
    "dev:web": "pnpm ui:update && vite --config vite.config.ts",
    "dev:docs": "pnpm ui:update && vite --config docs/vite.config.ts",
    "dev:tools": "node --import tsx tools/devframe/cli.ts dev",
    "build:sdk": "pnpm --filter @lody-mobile/sdk build",
    "build": "pnpm build:sdk && pnpm ui:update && wxt build",
    "build:firefox": "pnpm build:sdk && pnpm ui:update && wxt build -b firefox",
    "build:web": "pnpm build:sdk && pnpm ui:update && vite build",
    "build:docs": "pnpm build:sdk && pnpm ui:update && vite build --config docs/vite.config.ts",
    "zip": "pnpm build:sdk && pnpm ui:update && wxt zip",
    "prepare": "pnpm ui:update && wxt prepare",
    "build:ui": "node tools/ui/build.mjs",
    "ui:update": "node scripts/sync-ui.mjs && node scripts/generate-icons.mjs && pnpm build:ui",
    "typecheck": "pnpm build:ui && pnpm --filter @lody-mobile/sdk typecheck && wxt prepare && tsc --noEmit",
    "lint": "pnpm test:rules && pnpm lint:ast && oxlint --disable-nested-config && eslint .",
    "lint:fix": "pnpm test:rules && pnpm lint:ast && oxlint --disable-nested-config --fix && eslint . --fix",
    "test:sdk": "pnpm --filter @lody-mobile/sdk test",
    "test:sdk:package": "node scripts/sdk-package-smoke.mjs",
    "lint:ast": "ast-grep scan --error --globs '!vendor/**' --globs '!**/node_modules/**' --globs '!**/dist/**' --globs '!**/build/**' --globs '!.wxt/**' --globs '!.output/**' --globs '!.source/**' --globs '!storybook-static/**' --globs '!coverage/**' --globs '!reports/**' --globs '!test-results/**' --globs '!playwright-report/**' --globs '!**/generated/**' --globs '!**/generated.ts' --globs '!**/*.gen.ts' --globs '!**/*.gen.tsx'",
    "test:rules": "ast-grep test --skip-snapshot-tests",
    "format": "oxfmt --disable-nested-config .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "test": "pnpm test:sdk && pnpm test:sdk:package && pnpm test:browser && pnpm test:assurance",
    "test:browser": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:extension": "pnpm build && playwright test",
    "coverage:generate": "node scripts/generate-coverage.mjs",
    "storybook": "pnpm ui:update && storybook dev -p 6006 --no-open",
    "build:storybook": "pnpm ui:update && storybook build",
    "doctor": "react-doctor . --verbose",
    "knip": "knip",
    "check": "pnpm assurance:validate && pnpm test:assurance:tools && pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip",
    "postinstall": "pnpm prepare",
    "test:assurance": "node tools/assurance/run.mjs --extension",
    "test:assurance:tools": "node --test tools/assurance/*.test.mjs",
    "assurance:validate": "node tools/assurance/cli.mjs validate",
    "assurance:audit": "node tools/assurance/cli.mjs audit",
    "assurance:baseline": "node tools/assurance/cli.mjs baseline"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@lody-mobile/sdk": "workspace:*",
    "@lody/ui": "workspace:*",
    "@paper-design/shaders-react": "0.0.81",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.104.1",
    "@wibus/cuelens": "0.3.0",
    "jotai": "3.0.1",
    "loro-repo": "0.21.0",
    "motion": "14.0.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.1.0",
    "valibot": "1.2.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.1",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "^7.29.0",
    "@cucumber/cucumber": "13.2.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@stylexjs/unplugin": "0.19.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "cac": "^7.0.0",
    "devframe": "1.2.0",
    "eslint": "^9.39.0",
    "eslint-config-hyoban": "7.0.3",
    "fumadocs-core": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.18",
    "knip": "6.39.0",
    "next-themes": "0.4.6",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.63.0",
    "react-doctor": "0.9.14",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin": "^2.3.11",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
